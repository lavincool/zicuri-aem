# Cauce environment variables.
# Copy to .env.local for local development. On Vercel, set the same names in Project Settings → Environment Variables.
# Never commit real values.

# ── App ──────────────────────────────────────────────────────────────
# Public base URL, used for share links and Open Graph images.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shows the "Datos de demostración" badge while seeded data is in the database.
DEMO_MODE=true
# Secret used to sign cookies and to hash browser IDs and IP addresses (32+ random bytes).
# Generate one with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# ── Database (Turso / libSQL) ────────────────────────────────────────
# Local: a SQLite file. Production: libsql://<db>-<org>.turso.io
TURSO_DATABASE_URL=file:local.db
# Empty for local files; required for Turso Cloud.
TURSO_AUTH_TOKEN=

# ── Photo storage ────────────────────────────────────────────────────
# "local" writes uploads to ./.uploads through a dev-only route; "r2" uses Cloudflare R2.
STORAGE_DRIVER=local
# Cloudflare account ID (R2 endpoint: https://<account>.r2.cloudflarestorage.com).
R2_ACCOUNT_ID=
# R2 API token with Object Read & Write, scoped to the bucket below.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL that serves the bucket (custom domain or r2.dev), without a trailing slash.
R2_PUBLIC_BASE_URL=

# ── Map ──────────────────────────────────────────────────────────────
# Self-hosted style JSON files (they point at OpenFreeMap tiles).
NEXT_PUBLIC_MAP_STYLE_LIGHT=/map/styles/cauce-light.json
NEXT_PUBLIC_MAP_STYLE_DARK=/map/styles/cauce-dark.json

# ── Abuse protection ─────────────────────────────────────────────────
# Reports allowed per hour, per IP and per browser.
RATE_LIMIT_REPORTS_PER_HOUR=10
# Cloudflare Turnstile on report creation (invisible unless Cloudflare needs a click).
# Create a widget in the Cloudflare dashboard (mode "managed") for your domain plus
# localhost. Empty secret = off. TURNSTILE_HOSTNAMES lists the frontend hostnames
# siteverify must report (comma-separated; never localhost in production).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=
# Free OpenAI moderation of report photos and notes before publishing (needs OPENAI_API_KEY).
PHOTO_MODERATION_ENABLED=false

# ── Reverse geocoding (OpenStreetMap Nominatim) ──────────────────────
# Contact email sent in the User-Agent, as Nominatim's usage policy requires. Empty disables geocoding.
GEOCODER_CONTACT_EMAIL=

# ── Authorities panel ────────────────────────────────────────────────
# Shared password for /panel.
PANEL_PASSWORD=
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>" to /api/cron/forecast.
CRON_SECRET=

# ── Weather ──────────────────────────────────────────────────────────
# Optional: only needed for commercial use of Open-Meteo.
OPEN_METEO_API_KEY=
# Fetch the official SMN (CONAGUA) municipal forecast too.
SMN_ENABLED=true

# ── AI category suggestions (optional) ───────────────────────────────
# OPENAI_API_KEY also powers PHOTO_MODERATION_ENABLED above.
AI_SUGGESTIONS_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# ── Operator portal sign-in (/operador) ──────────────────────────────
# "console" prints magic links to the server log; a real email provider is chosen before launch.
EMAIL_DRIVER=console
EMAIL_FROM="Cauce <no-reply@cauce.example>"

# ── Sensor simulator ─────────────────────────────────────────────────
# Base URL the simulator sends readings to.
SIMULATOR_BASE_URL=http://localhost:3000
